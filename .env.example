# Model Provider: "ollama", "gemini", or "openai"
MODEL_PROVIDER=ollama

# Local Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=qwen2.5-coder:7b

# Cloud API Keys (Optional, fallback if MODEL_PROVIDER is set to gemini or openai)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Execution & DuckDB Configuration
DUCKDB_MAX_MEMORY=2GB
EXECUTION_TIMEOUT_SECONDS=10
MAX_SELF_CORRECTION_ITERATIONS=3
